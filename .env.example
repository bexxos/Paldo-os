# Placeholder environment for paldo-outbound-agent.
#
# Copy to .env (or export these in your shell) and replace every value.
# Nothing here is a real route, account, workspace, or credential.
# The pipeline runs with none of these set: every value has a safe placeholder
# default in code, and every feature that would need a real value fails closed.

# ---- workspace and database ------------------------------------------------
# Root of the checkout. Defaults to the directory containing the module.
PALDO_WORKSPACE=
# Canonical SQLite database. Defaults to <workspace>/data/paldo_os_outbound.sqlite3.
PALDO_DB_PATH=
# Lock file used by the bounded Reddit pollers.
PALDO_REDDIT_LOCK=
# Local timezone used for "today"-style quota accounting (IANA name).
PALDO_LOCAL_TIMEZONE=UTC
# Fixed UTC offset used when a poll run records local wall-clock time.
PALDO_LOCAL_UTC_OFFSET=+0 hours

# ---- notification routing (see notifier.py) --------------------------------
# Backend: console (default) or json_file.
PALDO_NOTIFICATION_BACKEND=console
# JSON Lines target used by the json_file backend.
PALDO_NOTIFICATION_JSONL_PATH=./out/notifications.jsonl
# Route identifier for the default channel (placeholder).
PALDO_NOTIFICATION_CHANNEL_ID=1001
# Identifier of the human operator allowed to authorize state changes (placeholder).
PALDO_NOTIFICATION_OPERATOR_ID=1001
# Named channels as a JSON object of placeholder identifiers.
PALDO_NOTIFICATION_CHANNELS={"control": 1001, "outbound_queue": 1002, "replies_pipeline": 1003, "growth_review": 1004, "alerts": 1005}

# ---- market / lane configuration -------------------------------------------
# ISO country codes treated as the primary lane (comma separated, empty by default).
PALDO_PRIMARY_LANE_COUNTRIES=
# Research-text markers treated as the primary lane (comma separated).
PALDO_PRIMARY_LANE_MARKERS=primary region
# Business names excluded from a live production lane (comma separated, empty by default).
PALDO_EXCLUDED_BUSINESSES=
# Gmail account drafts may be created from. Placeholder; drafts only, never sends.
PALDO_GMAIL_ACCOUNT=owner@example.invalid
# Optional path to an env file read for provider credentials.
PALDO_ENV_PATH=~/.hermes/.env

# ---- saved-handoff recovery (paldo_recovery.py, paldo_revision.py) ----------
# Directory holding the saved handoff JSON files.
PALDO_RECOVERY_DIR=
# Identifier of the run being recovered (placeholder).
PALDO_RECOVERY_RUN_ID=
# Expected provider run/dataset identifiers for each lane (placeholders).
PALDO_PRIMARY_REMOTE_RUN_ID=
PALDO_PRIMARY_DATASET_ID=
PALDO_SECONDARY_REMOTE_RUN_ID=
PALDO_SECONDARY_DATASET_ID=
# Saved research snapshot used by the experimental revision.
PALDO_REVISION_RESEARCH=
# Prefix used for the experimental revision key.
PALDO_REVISION_KEY_PREFIX=

# ---- opportunity delivery channels ----------------------------------------
PALDO_CHANNEL_BUSINESS=business
PALDO_CHANNEL_JOBS=jobs
# Optional external job-monitor checkout; when unset the job handoff is skipped.
PALDO_JOB_MONITOR_DIR=
# DonSeTch CLI binary used for public web/Reddit retrieval.
PALDO_DONSETCH_BIN=

# ---- provider credentials --------------------------------------------------
# Never commit real values. The pipeline refuses live calls without them.
GOOGLE_PLACES_API_KEY=
APIFY_API_TOKEN=
